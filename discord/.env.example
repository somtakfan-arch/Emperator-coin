# Токен бота: https://discord.com/developers/applications -> Bot -> Reset Token
DISCORD_TOKEN=

# Application ID: вкладка General Information
DISCORD_CLIENT_ID=

# ID сервера: настройки Discord -> Расширенные -> Режим разработчика,
# затем ПКМ по серверу -> Копировать ID сервера
DISCORD_GUILD_ID=

# Куда бот пишет данные (заявки, выговоры, активность)
DATA_FILE=./data/store.json
