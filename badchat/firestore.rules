rules_version = '2';

// ============================================================
//  Badchat — правила доступа Firestore
//  Читать и писать в чат могут только его участники.
//  Профиль редактирует только владелец.
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }

    // ---------- Профили ----------
    match /users/{userId} {
      // любой авторизованный может найти человека по юзернейму
      allow read: if signedIn();

      allow create: if signedIn()
                    && userId == uid()
                    && request.resource.data.uid == uid()
                    && request.resource.data.username is string
                    && request.resource.data.username.size() >= 3
                    && request.resource.data.username.size() <= 20
                    && request.resource.data.username.matches('^[a-z0-9_]+$');

      // менять можно только своё, uid и username неизменны
      allow update: if signedIn()
                    && userId == uid()
                    && request.resource.data.uid == resource.data.uid
                    && request.resource.data.username == resource.data.username;

      allow delete: if false;
    }

    // ---------- Занятые юзернеймы ----------
    // Читаем при регистрации (до создания профиля), пишем один раз за собой.
    match /usernames/{username} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.uid == uid();
      allow update, delete: if false;
    }

    // ---------- Чаты ----------
    match /chats/{chatId} {

      function isMember() {
        return signedIn() && uid() in resource.data.members;
      }
      function staysMember() {
        return signedIn() && uid() in request.resource.data.members;
      }
      // участников можно только добавлять (и только в группах)
      function membersOk() {
        return request.resource.data.members.hasAll(resource.data.members)
               && request.resource.data.members.size() <= 200
               && (resource.data.type == 'group'
                   || request.resource.data.members == resource.data.members);
      }

      allow read: if isMember();

      allow create: if staysMember()
                    && request.resource.data.createdBy == uid()
                    && request.resource.data.type in ['private', 'group']
                    && request.resource.data.members.size() >= 2
                    && request.resource.data.members.size() <= 200;

      // участник может обновлять чат (lastMessage, read, typing, участники группы),
      // но не подменять тип и создателя и не выкидывать других людей
      allow update: if isMember()
                    && staysMember()
                    && membersOk()
                    && request.resource.data.type == resource.data.type
                    && request.resource.data.createdBy == resource.data.createdBy;

      allow delete: if false;

      // ---------- Сообщения ----------
      match /messages/{messageId} {

        function chatMember() {
          return signedIn()
                 && uid() in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
        }

        allow read: if chatMember();

        allow create: if chatMember()
                      && request.resource.data.senderId == uid()
                      && request.resource.data.type in ['text', 'image', 'voice']
                      && (!('text' in request.resource.data)
                          || request.resource.data.text.size() <= 4000);

        // править и удалять можно только свои сообщения
        allow update, delete: if chatMember() && resource.data.senderId == uid();
      }
    }

    // всё остальное закрыто
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
