# Токен от @BotFather. НИКОГДА не коммить настоящий токен в git.
BOT_TOKEN=123456:PUT-YOUR-FRESH-TOKEN-HERE

# ID владельцев бота через запятую (узнать: команда /id в чате с ботом).
OWNER_IDS=

# Чат/канал для логов модерации (бот должен быть там админом). Необязательно.
LOG_CHAT_ID=

# Путь к базе данных SQLite.
DB_PATH=bed_protector.sqlite3
