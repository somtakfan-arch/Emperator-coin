# Copy to .env and fill in real values before running the server.

# Secret used to sign JWT session tokens. Generate with: openssl rand -hex 32
JWT_SECRET=change_me_to_a_long_random_string

# Shared secret the Minecraft plugin must send on every request (Authorization: Bearer <key>).
# Generate a separate random string and put the same value in the plugin's config.yml.
PLUGIN_API_KEY=change_me_to_a_long_random_string

# Port the API server listens on.
PORT=3000
