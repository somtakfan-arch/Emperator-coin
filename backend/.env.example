# Copy to .env and fill in real values before running the server locally.
# On Netlify, set these same variables in Site settings -> Environment variables
# instead of committing a .env file.

# Secret used to sign JWT session tokens. Generate with: openssl rand -hex 32
JWT_SECRET=change_me_to_a_long_random_string

# Shared secret the Minecraft plugin must send on every request (Authorization: Bearer <key>).
# Generate a separate random string and put the same value in the plugin's config.yml.
PLUGIN_API_KEY=change_me_to_a_long_random_string

# Full JSON of a Firebase service account key, as ONE line (Firebase console ->
# Project settings -> Service accounts -> Generate new private key).
# Not needed if FIRESTORE_EMULATOR_HOST is set instead (local emulator mode).
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# Port the API server listens on (local dev only, ignored on Netlify).
PORT=3000

# --- Local emulator mode (optional, instead of a real Firebase project) ---
# Uncomment to run against `firebase emulators:start --only firestore`:
# FIRESTORE_EMULATOR_HOST=localhost:8080
# FIREBASE_PROJECT_ID=emperator-bank-dev
