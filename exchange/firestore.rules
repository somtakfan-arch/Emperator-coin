rules_version = '2';

// Правила для Bed Exchange (симулятор).
// Вставь целиком: Firebase Console → Firestore Database → Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function userPath(uid) { return /databases/$(database)/documents/users/$(uid); }
    function isNum(v) { return v is int || v is float; }
    function nonNeg(v) { return isNum(v) && v >= 0; }
    function pos(v) { return isNum(v) && v > 0; }
    function coins() { return ['USDT', 'BTC', 'ETH', 'SOL', 'BNB', 'XRP', 'DOGE', 'TON']; }
    function pairs() { return ['BTCUSDT', 'ETHUSDT', 'SOLUSDT', 'BNBUSDT', 'XRPUSDT', 'DOGEUSDT', 'TONUSDT']; }
    function validNick(n) { return n is string && n.size() >= 2 && n.size() <= 20; }

    // Профиль: ник + стоимость портфеля читают все (рейтинг), пишет только владелец.
    match /users/{uid} {
      allow read: if true;

      // Создаётся один раз, в одной транзакции со стартовым балансом 10 000 USDT.
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['nick', 'createdAt', 'portfolioValue', 'updatedAt'])
        && validNick(request.resource.data.nick)
        && request.resource.data.createdAt == request.time
        && request.resource.data.portfolioValue == 10000
        && existsAfter(/databases/$(database)/documents/users/$(uid)/balances/USDT);

      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nick', 'portfolioValue', 'updatedAt'])
        && validNick(request.resource.data.nick)
        && nonNeg(request.resource.data.portfolioValue);

      allow delete: if false;

      // Балансы: amount — свободно, locked — заморожено под лимитные ордера.
      match /balances/{coin} {
        function validBalance() {
          let d = request.resource.data;
          return d.keys().hasAll(['amount', 'locked'])
            && d.keys().hasOnly(['amount', 'locked', 'avgPrice', 'updatedAt'])
            && nonNeg(d.amount)
            && nonNeg(d.locked)
            && (!('avgPrice' in d) || nonNeg(d.avgPrice));
        }

        allow read: if isOwner(uid);

        allow create: if isOwner(uid) && coin in coins() && validBalance()
          && (coin == 'USDT'
                // стартовые 10 000 — только при регистрации, вместе с профилем
                ? (!exists(userPath(uid)) && existsAfter(userPath(uid))
                   && request.resource.data.amount == 10000
                   && request.resource.data.locked == 0)
                : exists(userPath(uid)));

        allow update: if isOwner(uid) && validBalance();
        allow delete: if false;
      }

      // Лимитные ордера.
      match /orders/{orderId} {
        allow read: if isOwner(uid);

        allow create: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['pair', 'type', 'side', 'price', 'amount', 'status', 'createdAt'])
          && request.resource.data.pair in pairs()
          && request.resource.data.type == 'limit'
          && request.resource.data.side in ['buy', 'sell']
          && pos(request.resource.data.price)
          && pos(request.resource.data.amount)
          && request.resource.data.status == 'open'
          && request.resource.data.createdAt == request.time;

        // Можно только закрыть открытый ордер: исполнить или отменить.
        allow update: if isOwner(uid)
          && resource.data.status == 'open'
          && request.resource.data.status in ['filled', 'cancelled']
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'closedAt', 'filledPrice', 'fee']);

        allow delete: if false;
      }

      // История сделок — только добавлять.
      match /trades/{tradeId} {
        allow read: if isOwner(uid);

        allow create: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['pair', 'type', 'side', 'price', 'amount', 'total', 'fee', 'feeAsset', 'orderId', 'time'])
          && request.resource.data.pair in pairs()
          && request.resource.data.side in ['buy', 'sell']
          && pos(request.resource.data.price)
          && pos(request.resource.data.amount)
          && nonNeg(request.resource.data.fee)
          && request.resource.data.time == request.time;

        allow update, delete: if false;
      }
    }
  }
}
