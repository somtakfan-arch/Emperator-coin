# Token from @BotFather. Never commit the real value.
BOT_TOKEN=123456:your-token-here

# Where the SQLite file lives.
# Locally: data/bedmusic.db
# On Railway: mount a Volume at /data and set DB_PATH=/data/bedmusic.db,
# otherwise the database is wiped on every redeploy.
DB_PATH=data/bedmusic.db

# Tracks per page in the feed.
PAGE_SIZE=5

# Telegram user ids allowed to run /credit and /audit, space or comma separated.
ADMIN_IDS=

# 24-word treasury mnemonic. Until this is set, on-chain top-up and payout stay
# disabled and balances are funded manually by an admin. Set it in Railway
# variables only — never commit it, never paste it into a chat.
TON_TREASURY_MNEMONIC=

# Toncenter API key. Without one the public rate limit applies.
TON_API_KEY=

# Sending real value out is the one irreversible operation, so it is opt-in.
TON_WITHDRAWALS_ENABLED=false

# How often to poll the chain for incoming deposits.
TON_DEPOSIT_POLL_SECONDS=60
